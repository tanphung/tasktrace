{
  "name": "tasktrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:secrets": "node scripts/check-secrets.mjs",
    "release:bradbury": "node scripts/bradbury-release.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:v2:local": "node scripts/integration-v2-local.mjs",
    "test:router": "node scripts/test-receipt-router.mjs",
    "test:live-wallet": "vitest run --config vitest.live.config.ts --reporter=verbose",
    "test:types": "tsc -p tsconfig.tests.json",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/integration/receipts.test.mjs && vitest run --config vitest.config.ts",
    "test:frontend": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^24.11.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "hardhat": "^3.16.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
